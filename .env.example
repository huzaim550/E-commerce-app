# ---------------------------------------------------------------- database
# Local (docker/podman compose): the `postgres` service below.
DATABASE_URL="postgresql://store:store@localhost:5432/store?schema=public"

# Compose-only: credentials the postgres service is created with.
POSTGRES_USER=store
POSTGRES_PASSWORD=store
POSTGRES_DB=store

# ---------------------------------------------------------------- auth
# REQUIRED. Signs session cookies. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-openssl-rand-base64-32"

# Seed-only: the first admin account. Change the password before deploying.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"

# ---------------------------------------------------------------- site
# Used for absolute URLs in metadata, sitemap and OpenGraph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------- storage
# local = write to ./data/uploads (needs a persistent volume)
# s3    = any S3-compatible bucket: Cloudflare R2, Backblaze B2, MinIO, AWS
STORAGE_DRIVER=local

# Only read when STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL for objects, e.g. https://cdn.example.com or your R2 public bucket URL
S3_PUBLIC_URL=""
